# ============================================================
# .env.example - Mau cau hinh cho Han Ngu Server
# Copy thanh .env va sua theo may cua ban:
#   copy .env.example .env     (Windows)
#   cp .env.example .env       (Linux/Mac)
# KHONG commit file .env thuc te (co the chua thong tin nhay cam).
# ============================================================

# --- May chu ung dung ---
# Dia chi lang nghe. De 127.0.0.1 neu chi dung tren may nay,
# doi thanh 0.0.0.0 neu muon may khac trong mang LAN truy cap.
HOST=127.0.0.1
# Cong lang nghe.
PORT=8000

# --- Du lieu ---
# Duong dan file SQLite. Bo trong de dung mac dinh: data/hanngu.db
# ngay duoi thu muc app (di chuyen thu muc app thi du lieu di theo).
HANNGU_DB_PATH=
# Thu muc chua toan bo du lieu (media, recordings, backups, logs...).
# Bo trong de dung mac dinh: data/ ngay duoi thu muc app.
HANNGU_DATA_DIR=

# --- Video ---
# Duong dan ffmpeg. Bo trong de app tu tim (where/which ffmpeg).
FFMPEG_PATH=

# --- May AI Qwen (chay tren may thu 2 trong mang LAN) ---
# Vi du: may Qwen co IP 192.168.1.50 va Ollama chay cong 11434
QWEN_BASE_URL=http://192.168.1.50:11434
# Ten model Ollama tren may Qwen.
QWEN_MODEL=qwen2.5:7b

# --- Log ---
# Muc do log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
